---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';
import '../styles/landing.css';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

const hclCode = `<span class="cy">resource</span> <span class="o">"aws_vpc"</span> <span class="o">"main"</span> {
  cidr_block = <span class="g">"10.0.0.0/16"</span>
}

<span class="cy">resource</span> <span class="o">"aws_subnet"</span> <span class="o">"private"</span> {
  vpc_id     = aws_vpc.main.id
  cidr_block = <span class="g">"10.0.2.0/24"</span>
}

<span class="cy">resource</span> <span class="o">"aws_eks_cluster"</span> <span class="o">"app"</span> {
  vpc_config {
    subnet_ids = [aws_subnet.private.id]
  }
}`;

const stepCode = `<span class="c"># 1. Generate a plan</span>
<span class="cy">terraform</span> plan -out=tfplan

<span class="c"># 2. Pipe it into TerraView</span>
<span class="cy">terraform</span> show -json tfplan | <span class="g">terraview</span>`;

const ciCode = `<span class="cy">terraform</span> show -json tfplan > plan.json
<span class="g">terraview</span> -static -in plan.json -out terraview-report.html`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TerraView — Terraform plan preview before Atlantis</title>
    <meta name="description" content="TerraView turns terraform show -json into an interactive dependency graph with plan diffs and copy-paste Atlantis commands. One binary. Any provider." />
    <meta name="theme-color" content="#060a13" />
    <meta property="og:title" content="TerraView — Terraform plan preview before Atlantis" />
    <meta property="og:description" content="See exactly what Terraform will add, change, or destroy — with dependencies, diffs, and targeted commands." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://slimaineb.github.io/terraview/" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <SiteHeader />
    <main id="main">
      <section class="container hero">
        <div class="hero-grid">
          <div class="hero-copy">
            <span class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> Terraform plan preview · no MR round trip</span>
            <h1>See what Terraform will do <span class="gradient">before Atlantis does.</span></h1>
            <p class="hero-lede">TerraView turns <code>terraform show -json</code> into an interactive dependency graph with plan diffs and copy-paste Atlantis commands. One binary. Any provider.</p>
            <div class="hero-actions">
              <a class="button" href="#getting-started">
                Get started
                <Icon name="arrow-right" size={17} />
              </a>
              <a class="button button-ghost" href="https://github.com/SlimaineB/terraview/releases">
                <Icon name="download" size={17} />
                Download binary
              </a>
            </div>
            <ul class="hero-note">
              <li><Icon name="check-circle" size={14} /> Single Go binary</li>
              <li><Icon name="check-circle" size={14} /> No provider plugins</li>
              <li><Icon name="check-circle" size={14} /> Linux · macOS · Windows</li>
            </ul>
            <div class="pill-row" aria-label="Supported providers">
              <span class="provider-chip">AWS</span>
              <span class="provider-chip">Azure</span>
              <span class="provider-chip">GCP</span>
              <span class="provider-chip">Kubernetes</span>
              <span class="provider-chip">Helm</span>
              <span class="provider-chip">Docker</span>
            </div>
          </div>
          <div class="hero-visual">
            <div class="app-window">
              <div class="browser-bar" aria-hidden="true">
                <div class="browser-dots">
                  <i></i><i></i><i></i>
                </div>
                <div class="browser-address">
                  <Icon name="globe" size={10} />
                  localhost:8080
                </div>
              </div>
              <div class="app">
                <div class="app-top">
                  <div class="app-brand">
                    <span class="app-brand-icon" aria-hidden="true">
                      <Icon name="git_branch" size={14} />
                    </span>
                    TerraView
                  </div>
                  <div class="app-stats" aria-label="Plan summary">
                    <span class="pill existing">3 existing</span>
                    <span class="pill add">2 add</span>
                    <span class="pill modify">1 modify</span>
                    <span class="pill destroy">1 destroy</span>
                  </div>
                </div>
                <div class="app-context" aria-label="Repository context">
                  <span class="ctx-repo">
                    <Icon name="repo" size={11} />
                    <span>/workspace/infra</span>
                  </span>
                  <span class="ctx-branch">
                    <Icon name="git_branch" size={11} />
                    main
                  </span>
                  <span class="ctx-source">
                    <Icon name="doc" size={11} />
                    plan.json
                  </span>
                </div>
                <div class="app-body">
                  <div class="graph-wrap">
                    <svg class="graph-svg" viewBox="0 0 640 330" role="img" aria-label="Terraform dependency graph with VPC, subnet, EKS, RDS, IAM, security group, and S3 nodes">
                      <defs>
                        <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                          <path d="M 0 0 L 10 5 L 0 10 z" fill="#334155"/>
                        </marker>
                      </defs>
                      <path class="edge" d="M201 60 C210 60, 210 116, 220 116"/>
                      <path class="edge" d="M201 174 C210 174, 210 128, 220 128"/>
                      <path class="edge" d="M405 116 C418 116, 418 60, 430 60"/>
                      <path class="edge" d="M405 128 C418 128, 418 174, 430 174"/>
                      <path class="edge" d="M405 252 C418 252, 418 72, 430 72"/>

                      <g class="node add">
                        <rect class="box" x="16" y="36" width="185" height="48" rx="11"/>
                        <circle class="dot" cx="34" cy="60" r="3.5"/>
                        <text class="label" x="46" y="63">aws_vpc.main</text>
                        <rect class="badge" x="156" y="46" width="31" height="14" rx="4"/>
                        <text class="badge-text" x="171.5" y="55.5" text-anchor="middle">ADD</text>
                      </g>
                      <g class="node noop">
                        <rect class="box" x="16" y="150" width="185" height="48" rx="11"/>
                        <circle class="dot" cx="34" cy="174" r="3.5"/>
                        <text class="label" x="46" y="177">aws_security_group.api</text>
                        <rect class="badge" x="156" y="160" width="31" height="14" rx="4"/>
                        <text class="badge-text" x="171.5" y="169.5" text-anchor="middle">NO-OP</text>
                      </g>
                      <g class="node modify">
                        <rect class="box" x="220" y="92" width="185" height="48" rx="11"/>
                        <circle class="dot" cx="238" cy="116" r="3.5"/>
                        <text class="label" x="250" y="119">aws_subnet.private</text>
                        <rect class="badge" x="360" y="102" width="31" height="14" rx="4"/>
                        <text class="badge-text" x="375.5" y="111.5" text-anchor="middle">MOD</text>
                      </g>
                      <g class="node noop">
                        <rect class="box" x="220" y="228" width="185" height="48" rx="11"/>
                        <circle class="dot" cx="238" cy="252" r="3.5"/>
                        <text class="label" x="250" y="255">aws_iam_role.irsa</text>
                        <rect class="badge" x="360" y="238" width="31" height="14" rx="4"/>
                        <text class="badge-text" x="375.5" y="247.5" text-anchor="middle">NO-OP</text>
                      </g>
                      <g class="node noop">
                        <rect class="box" x="430" y="36" width="194" height="48" rx="11"/>
                        <circle class="dot" cx="448" cy="60" r="3.5"/>
                        <text class="label" x="460" y="63">aws_eks_cluster.app</text>
                        <rect class="badge" x="580" y="46" width="31" height="14" rx="4"/>
                        <text class="badge-text" x="595.5" y="55.5" text-anchor="middle">NO-OP</text>
                      </g>
                      <g class="node add">
                        <rect class="box" x="430" y="150" width="194" height="48" rx="11"/>
                        <circle class="dot" cx="448" cy="174" r="3.5"/>
                        <text class="label" x="460" y="177">aws_rds_instance.db</text>
                        <rect class="badge" x="580" y="160" width="31" height="14" rx="4"/>
                        <text class="badge-text" x="595.5" y="169.5" text-anchor="middle">ADD</text>
                      </g>
                      <g class="node destroy">
                        <rect class="box" x="430" y="244" width="194" height="48" rx="11"/>
                        <circle class="dot" cx="448" cy="268" r="3.5"/>
                        <text class="label" x="460" y="271">aws_s3_bucket.logs</text>
                        <rect class="badge" x="580" y="254" width="31" height="14" rx="4"/>
                        <text class="badge-text" x="595.5" y="263.5" text-anchor="middle">DEL</text>
                      </g>
                    </svg>
                  </div>
                  <aside class="mock-inspector" aria-label="Resource diff preview">
                    <div class="inspector-head">
                      <span class="name">aws_subnet.private</span>
                      <span class="pill modify">MODIFY</span>
                    </div>
                    <div class="mock-kicker">Attribute diff</div>
                    <div class="diff-box">
                      <div class="diff-old">- 10.0.1.0/24</div>
                      <div class="diff-new">+ 10.0.2.0/24</div>
                    </div>
                    <div class="mock-kicker">Dependencies</div>
                    <div class="dep"><span class="up">↑</span> aws_vpc.main</div>
                    <div class="dep"><span class="down">↓</span> aws_eks_cluster.app</div>
                    <div class="mock-kicker">Targeted command</div>
                    <div class="cmd-box">atlantis plan -- -target=aws_subnet.private</div>
                  </aside>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="why" class="section">
        <div class="container">
          <div class="section-head">
            <div class="kicker"><span class="kicker-dot" aria-hidden="true"></span> Why TerraView</div>
            <h2>Your plan, without the round trip.</h2>
            <p>Atlantis is great for approval. It is a slow way to answer "what will this change?". TerraView gives you the answer locally, in seconds.</p>
          </div>
          <div class="grid-3">
            <article class="card">
              <div class="card-icon">
                <Icon name="zap" size={18} />
              </div>
              <h3>No Atlantis wait</h3>
              <p>Generate a plan locally, pipe it into TerraView, and inspect the graph before you open the MR.</p>
            </article>
            <article class="card">
              <div class="card-icon">
                <Icon name="boxes" size={18} />
              </div>
              <h3>Dependency-aware</h3>
              <p>Upstream and downstream resources are reconstructed from <code>configuration</code>, <code>depends_on</code>, and prior state.</p>
            </article>
            <article class="card">
              <div class="card-icon">
                <Icon name="layout" size={18} />
              </div>
              <h3>Actionable commands</h3>
              <p>Copy <code>terraform -target</code> or Atlantis commands for the exact resource you are reviewing.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="getting-started" class="section">
        <div class="container">
          <div class="section-head">
            <div class="kicker"><span class="kicker-dot" aria-hidden="true"></span> Getting started</div>
            <h2>From plan to preview in two commands.</h2>
            <p>TerraView is a local server. It reads plan JSON from stdin, opens a browser, and never sends your plan anywhere.</p>
          </div>
          <div class="steps-grid">
            <div class="code-block">
              <div class="code-head">
                <span>terminal</span>
                <button class="copy-btn" type="button">Copy</button>
              </div>
              <pre><code set:html={stepCode}></code></pre>
            </div>
            <ol class="steps">
              <li class="step">
                <span class="step-num">1</span>
                <div>
                  <h3>Plan locally</h3>
                  <p>Use your normal workspace, credentials, and variables. TerraView only consumes the JSON output.</p>
                </div>
              </li>
              <li class="step">
                <span class="step-num">2</span>
                <div>
                  <h3>Inspect the graph</h3>
                  <p>Your browser opens on a DAG grouped by dependency level, with add, modify, destroy, and existing resources.</p>
                </div>
              </li>
              <li class="step">
                <span class="step-num">3</span>
                <div>
                  <h3>Copy the command</h3>
                  <p>Click a node to see the diff, dependencies, and the targeted Atlantis command for that resource.</p>
                </div>
              </li>
            </ol>
          </div>
        </div>
      </section>

      <section id="example" class="section">
        <div class="container">
          <div class="section-head">
            <div class="kicker"><span class="kicker-dot" aria-hidden="true"></span> Example</div>
            <h2>A VPC, a subnet, and an EKS cluster.</h2>
            <p>This is the kind of chain TerraView reconstructs from a real plan. No guessing which resource to target.</p>
          </div>
          <div class="example-grid">
            <div class="code-block">
              <div class="code-head">
                <span>main.tf</span>
                <button class="copy-btn" type="button">Copy</button>
              </div>
              <pre><code set:html={hclCode}></code></pre>
            </div>
            <div>
              <div class="flow" aria-label="Dependency chain">
                <div class="flow-node">
                  <span class="type">aws_vpc.main</span>
                  <span class="flow-status add">ADD +</span>
                </div>
                <div class="flow-arrow" aria-hidden="true">
                  <Icon name="chevron" size={18} />
                </div>
                <div class="flow-node">
                  <span class="type">aws_subnet.private</span>
                  <span class="flow-status modify">MODIFY ~</span>
                </div>
                <div class="flow-arrow" aria-hidden="true">
                  <Icon name="chevron" size={18} />
                </div>
                <div class="flow-node">
                  <span class="type">aws_eks_cluster.app</span>
                  <span class="flow-status noop">EXISTING</span>
                </div>
              </div>
              <div class="example-note">
                <strong>TerraView sees the chain.</strong> Click <code>aws_subnet.private</code> to inspect the CIDR diff and copy <code>atlantis plan -- -target=aws_subnet.private</code>.
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="features" class="section">
        <div class="container">
          <div class="section-head">
            <div class="kicker"><span class="kicker-dot" aria-hidden="true"></span> Features</div>
            <h2>Everything you need to review a plan.</h2>
            <p>Built for Terraform reviewers who want signal, not another dashboard.</p>
          </div>
          <div class="feature-grid">
            <article class="feature">
              <div class="feature-icon" aria-hidden="true">
                <Icon name="boxes" size={16} />
              </div>
              <div>
                <h3>Interactive DAG</h3>
                <p>Topological levels, zoom, pan, and upstream/downstream visibility.</p>
              </div>
            </article>
            <article class="feature">
              <div class="feature-icon" aria-hidden="true">
                <Icon name="layout" size={16} />
              </div>
              <div>
                <h3>Resource diff inspector</h3>
                <p>Formatted before/after JSON with line-level highlights for inline policies and nested values.</p>
              </div>
            </article>
            <article class="feature">
              <div class="feature-icon" aria-hidden="true">
                <Icon name="terminal" size={16} />
              </div>
              <div>
                <h3>Atlantis commands</h3>
                <p>Copy plan, apply, destroy, import, and targeted commands per resource.</p>
              </div>
            </article>
            <article class="feature">
              <div class="feature-icon" aria-hidden="true">
                <Icon name="search" size={16} />
              </div>
              <div>
                <h3>Search and action filters</h3>
                <p>Focus on add, modify, destroy, or existing resources — including a dedicated destroy view.</p>
              </div>
            </article>
            <article class="feature">
              <div class="feature-icon" aria-hidden="true">
                <Icon name="doc" size={16} />
              </div>
              <div>
                <h3>Static CI reports</h3>
                <p>Export a single HTML file and attach it to a CI job or review.</p>
              </div>
            </article>
            <article class="feature">
              <div class="feature-icon" aria-hidden="true">
                <Icon name="folder_open" size={16} />
              </div>
              <div>
                <h3>Multi-plan context</h3>
                <p>Switch project, environment, and workspace plans in one UI; repo path and branch stay visible.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="ci" class="section">
        <div class="container">
          <div class="section-head">
            <div class="kicker"><span class="kicker-dot" aria-hidden="true"></span> CI-ready</div>
            <h2>Attach a plan report to every pull request.</h2>
            <p>No server, no plugin, no extra infrastructure. Generate the report and upload it as an artifact.</p>
          </div>
          <div class="steps-grid">
            <div class="code-block">
              <div class="code-head">
                <span>ci.sh</span>
                <button class="copy-btn" type="button">Copy</button>
              </div>
              <pre><code set:html={ciCode}></code></pre>
            </div>
            <div class="card">
              <h3>One file to share</h3>
              <p>The report embeds the graph data and opens in any browser. Upload it as a GitHub Actions or GitLab CI artifact, or link it from a review.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="cta-panel">
            <div>
              <div class="kicker"><span class="kicker-dot" aria-hidden="true"></span> Ready to see your plan?</div>
              <h2>Stop waiting for a DAG.</h2>
              <p>Download TerraView, pipe a plan, and inspect the change in seconds.</p>
            </div>
            <div class="cta-actions">
              <a class="button" href="https://github.com/SlimaineB/terraview/releases">Download binary</a>
              <a class="button button-ghost" href="https://github.com/SlimaineB/terraview">View on GitHub</a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
    <script>
      document.querySelectorAll('.copy-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const block = btn.closest('.code-block');
          const code = block && block.querySelector('code');
          if (!code) return;
          try {
            await navigator.clipboard.writeText(code.innerText);
            const original = btn.textContent;
            btn.textContent = 'Copied';
            btn.classList.add('copied');
            setTimeout(() => {
              btn.textContent = original;
              btn.classList.remove('copied');
            }, 1400);
          } catch (err) {
            console.error('Copy failed', err);
          }
        });
      });
    </script>
  </body>
</html>