---
import logo from '../assets/logo.svg';
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL;
const docs = `${base}overview/`;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={base} aria-label="TerraView home">
      <img src={logo.src} width="36" height="36" alt="" />
      <span>TerraView</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      <a href={`${base}#why`}>Why</a>
      <a href={`${base}#getting-started`}>Quick start</a>
      <a href={`${base}#example`}>Example</a>
      <a href={`${base}#features`}>Features</a>
      <a href={`${base}#ci`}>CI</a>
      <a href={docs}>Docs</a>
    </nav>

    <div class="header-actions">
      <a
        class="icon-link"
        href="https://github.com/SlimaineB/terraview"
        aria-label="TerraView on GitHub"
      >
        <Icon name="github" size={20} />
      </a>
      <a class="button button-small" href="https://github.com/SlimaineB/terraview/releases">Download</a>
    </div>
  </div>
</header>